    "@antfu/eslint-config": "^9.2.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "aws-cdk": "2.1135.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
